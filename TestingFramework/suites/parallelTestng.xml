<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="CCST Cross-Browser" verbose="1" parallel="tests" thread-count="2">
    <listeners>
        <listener class-name="com.ccst.reports.ExtentTestListener"></listener>
    </listeners>
    <test name="Chrome">
        <parameter name="browser" value="chrome"/>
        <classes>
            <class name="com.ccst.tests.LoginPageTest"/>
        </classes>
    </test>
    <test name="Edge">
            <parameter name="browser" value="edge"/>
            <classes>
                <class name="com.ccst.tests.LoginPageTest"/>
            </classes>
    </test>
</suite>