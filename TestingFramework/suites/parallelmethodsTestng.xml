<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="CCST Parallel " verbose="1" parallel="tests" thread-count="3">
    <listeners>
        <listener class-name="com.ccst.reports.ExtentTestListener"></listener>
    </listeners>
    <test name="Login in parallel">
        <classes>
            <class name="com.ccst.tests.LoginPageTest"/>
            <class name="com.ccst.tests.SimpleTest"/>
        </classes>
    </test>
</suite>